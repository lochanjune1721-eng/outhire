# Set these in the Vercel dashboard (Project -> Settings -> Environment Variables).

# Client-safe. Also copy these two into /js/config.js, which is what the browser
# reads — there is no build step, so nothing injects them into static files.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server only. Never appears in any HTML or JS the browser downloads.
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ACCOUNT_ID=acct_1SNgH8ItrE8tEH6a

ADMIN_PASSWORD=

# Optional. Without a key the upload link is written to the function log
# instead of being emailed, so the flow still completes end to end.
RESEND_API_KEY=
MAIL_FROM=Outhire <onboarding@resend.dev>

# Optional. Overrides the host used to build success, cancel and upload URLs.
SITE_URL=
