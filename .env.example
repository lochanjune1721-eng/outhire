# ┌───────────────────────────────────────────────────────────────────────────┐
# │  TEMPLATE ONLY — THIS FILE IS COMMITTED TO A PUBLIC REPOSITORY.           │
# │  Every value below must stay empty. Anything pasted here is published.    │
# │                                                                           │
# │  Real values go in the Vercel dashboard                                   │
# │    Project → Settings → Environment Variables                             │
# │  For local scripts, put them in .env.local — it is gitignored.            │
# │                                                                           │
# │  SUPABASE_SERVICE_ROLE_KEY bypasses every RLS policy in sql/schema.sql.   │
# │  Publishing it hands anyone full read and write on the database,          │
# │  including balances. If it ever lands in a commit, rotate it immediately  │
# │  in Supabase → Settings → API — removing it from the file does not        │
# │  remove it from git history.                                              │
# └───────────────────────────────────────────────────────────────────────────┘

SUPABASE_URL=
SUPABASE_ANON_KEY=              # safe in client JS (also lives in js/config.js)
SUPABASE_SERVICE_ROLE_KEY=      # serverless + seed scripts only, never client

# Dodo Payments
DODO_API_KEY=
DODO_WEBHOOK_SECRET=            # the whsec_... signing secret
DODO_PRODUCT_ID=                # the credit product created in the Dodo dashboard
DODO_MODE=test                  # test | live
# DODO_API_BASE=                # override only if Dodo's host differs

ADMIN_PASSWORD=

SITE_URL=
