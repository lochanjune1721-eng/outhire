# Vercel project environment variables.
#
# THIS FILE IS A TEMPLATE AND IS COMMITTED TO A PUBLIC REPOSITORY.
# Never put a real value in it. Real values go in the Vercel dashboard
# (Project → Settings → Environment Variables) and nowhere else in this repo.
#
# The one exception is SUPABASE_ANON_KEY, which is public by design and is read
# from js/config.js because there is no build step to inject it.

SUPABASE_URL=
SUPABASE_ANON_KEY=              # safe in client JS (also lives in js/config.js)
SUPABASE_SERVICE_ROLE_KEY=      # serverless only — bypasses RLS, never commit

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ACCOUNT_ID=acct_1SNgH8ItrE8tEH6a

# Job-link parsing. Provider-neutral on purpose.
#   LLM_PROVIDER=openai     -> any OpenAI-compatible /chat/completions endpoint
#                              (DeepSeek, OpenAI, Together, Groq, vLLM, ...)
#   LLM_PROVIDER=anthropic  -> the Anthropic Messages API
# Leave LLM_API_KEY unset and job.html falls back to the manual paste form.
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

ADMIN_PASSWORD=

# Optional. Without RESEND_API_KEY, upload links and reveal notices are
# written to the function log instead of vanishing silently.
RESEND_API_KEY=
MAIL_FROM=outbid.lol <onboarding@resend.dev>
SITE_URL=
